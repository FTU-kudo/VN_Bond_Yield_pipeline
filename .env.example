# Biến môi trường — Sao chép thành .env và điền giá trị thật
# File .env đã nằm trong .gitignore — ĐỪNG commit lên Git

# ── VBMA (chỉ cần nếu dùng vm.vbma.*) ──────────────────────────────────────
# Nếu không điền, các hàm vbma.* ném MissingCredentials, phần còn lại vẫn chạy
VBMA_USERNAME=
VBMA_PASSWORD=

# ── Thư mục cache (tuỳ chọn, mặc định là ./cache) ──────────────────────────
# VNBOND_HOME=~/.vnbond

# ── Cấu hình pipeline ────────────────────────────────────────────────────────
# Ngày bắt đầu backfill (để trống = 2012-01-01)
# PIPELINE_START_DATE=2012-01-01
